      "hash": "9ba54776f6",
      "file": "U10.L04/item.U10.L04.P3.hint.f.9ba54776f6.mp3",
      "text": "ما المرحلة التي أنتِ فيها؟ وما الذي بعدها؟"
    },
    {
      "key": "item.U10.L04.P3.why",
      "hash": "7f8cbd8088",
      "file": "U10.L04/item.U10.L04.P3.why.7f8cbd8088.mp3",
      "text": "الرضاعة، ثم الطفولة، ثم البلوغ، ثم الرشد، ثم الشيخوخة."
    },
    {
      "key": "item.U10.L04.P4",
      "hash": "0c520bbe27",
      "file": "U10.L04/item.U10.L04.P4.0c520bbe27.mp3",
      "text": "أي هذه يبطئ ضعف العظم والعضلة في الكبر؟"
    },
    {
      "key": "item.U10.L04.P4.hint",
      "hash": "3532d37dd9",
      "file": "U10.L04/item.U10.L04.P4.hint.3532d37dd9.mp3",
      "text": "ما الذي يقوي العظم والعضلة؟"
    },
    {
      "key": "item.U10.L04.P4.why",
      "hash": "d815102d34",
      "file": "U10.L04/item.U10.L04.P4.why.d815102d34.mp3",
      "text": "الرياضة من أفضل ما يبطئ ضعف العظم والعضلة."
    },
    {
      "key": "item.U10.L04.P4.opt1",
      "hash": "134bdc025d",
      "file": "U10.L04/item.U10.L04.P4.opt1.134bdc025d.mp3",
      "text": "الجلوس يضعفها."
    },
    {
      "key": "item.U10.L04.P4.opt2",
      "hash": "6a192922b9",
      "file": "U10.L04/item.U10.L04.P4.opt2.6a192922b9.mp3",
      "text": "الجسم يحتاج غذاء متوازناً."
    },
    {
      "key": "item.U10.L04.P4.opt3",
      "hash": "bbf4afb26a",
      "file": "U10.L04/item.U10.L04.P4.opt3.bbf4afb26a.mp3",
      "text": "الحركة هي التي تنفع."
    },
    {
      "key": "item.U10.L04.P5.m",
      "gender": "m",
      "hash": "93017adbee",
      "file": "U10.L04/item.U10.L04.P5.m.93017adbee.mp3",
      "text": "جدتك لا تسمع جيداً. كيف تكلمها؟"
    },
    {
      "key": "item.U10.L04.P5.f",
      "gender": "f",
      "hash": "f84d441e6d",
      "file": "U10.L04/item.U10.L04.P5.f.f84d441e6d.mp3",
      "text": "جدتكِ لا تسمع جيداً. كيف تكلمينها؟"
    },
    {
      "key": "item.U10.L04.P5.hint",
      "hash": "12616415cb",
      "file": "U10.L04/item.U10.L04.P5.hint.12616415cb.mp3",
      "text": "ما الذي يجعل الكلام أوضح؟"
    },
    {
      "key": "item.U10.L04.P5.why",
      "hash": "6134381546",
      "file": "U10.L04/item.U10.L04.P5.why.6134381546.mp3",
      "text": "بوضوح، ووجهك إليها، بلا صراخ."
    },
    {
      "key": "item.U10.L04.P5.opt0",
      "hash": "b807903a5e",
      "file": "U10.L04/item.U10.L04.P5.opt0.b807903a5e.mp3",
      "text": "الصراخ من بعيد لا يعين."
    },
    {
      "key": "item.U10.L04.P5.opt1",
      "hash": "c9bd667705",
      "file": "U10.L04/item.U10.L04.P5.opt1.c9bd667705.mp3",
      "text": "تحتاج أن ترى وجهك."
    },
    {
      "key": "item.U10.L04.P5.opt3",
      "hash": "9f30a9a71b",
      "file": "U10.L04/item.U10.L04.P5.opt3.9f30a9a71b.mp3",
      "text": "الكلام معها برّ يفرحها."
    },
    {
      "key": "item.U10.L04.C1.m",
      "gender": "m",
      "hash": "a6d3f17bf9",
      "file": "U10.L04/item.U10.L04.C1.m.a6d3f17bf9.mp3",
      "text": "صف بداية الإنسان ونموه قبل أن يولد بثلاث جمل."
    },
    {
      "key": "item.U10.L04.C1.f",
      "gender": "f",
      "hash": "e2a258693f",
      "file": "U10.L04/item.U10.L04.C1.f.e2a258693f.mp3",
      "text": "صفي بداية الإنسان ونموه قبل أن يولد بثلاث جمل."
    },
    {
      "key": "item.U10.L04.C2",
      "hash": "58ea300f23",
      "file": "U10.L04/item.U10.L04.C2.58ea300f23.mp3",
      "text": "«السرّة أثر الحبل السري بعد الولادة». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.C3.m",
      "gender": "m",
      "hash": "cd0c3a9869",
      "file": "U10.L04/item.U10.L04.C3.m.cd0c3a9869.mp3",
      "text": "اذكر شيئاً يميز كل مرحلة من مراحل العمر الخمس."
    },
    {
      "key": "item.U10.L04.C3.f",
      "gender": "f",
      "hash": "333ab9a2b5",
      "file": "U10.L04/item.U10.L04.C3.f.333ab9a2b5.mp3",
      "text": "اذكري شيئاً يميز كل مرحلة من مراحل العمر الخمس."
    },
    {
      "key": "item.U10.L04.C4",
      "hash": "ba7f97b650",
      "file": "U10.L04/item.U10.L04.C4.ba7f97b650.mp3",
      "text": "«لا فائدة من الرياضة لمن كبر في السن». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.C5.m",
      "gender": "m",
      "hash": "13e5c3f6fb",
      "file": "U10.L04/item.U10.L04.C5.m.13e5c3f6fb.mp3",
      "text": "اكتب ثلاثة أشياء تعين بها جاراً كبيراً، ولكل منها سبب من الجسم."
    },
    {
      "key": "item.U10.L04.C5.f",
      "gender": "f",
      "hash": "d05a9cd0f5",
      "file": "U10.L04/item.U10.L04.C5.f.d05a9cd0f5.mp3",
      "text": "اكتبي ثلاثة أشياء تعينين بها جاراً كبيراً، ولكل منها سبب من الجسم."
    },
    {
      "key": "item.U10.L04.C6.m",
      "gender": "m",
      "hash": "63545a64c5",
      "file": "U10.L04/item.U10.L04.C6.m.63545a64c5.mp3",
      "text": "قال يوسف: «المولود لا يتكلم، فلا نستطيع أن نعرف ماذا يعرف». صحّح له."
    },
    {
      "key": "item.U10.L04.C6.f",
      "gender": "f",
      "hash": "7bfe525e32",
      "file": "U10.L04/item.U10.L04.C6.f.7bfe525e32.mp3",
      "text": "قال يوسف: «المولود لا يتكلم، فلا نستطيع أن نعرف ماذا يعرف». صحّحي له."
    },
    {
      "key": "item.U10.L04.A1.a",
      "hash": "3c07f12bf8",
      "file": "U10.L04/item.U10.L04.A1.a.3c07f12bf8.mp3",
      "text": "كيف يحصل الجنين على غذائه؟"
    },
    {
      "key": "item.U10.L04.A1.a.why",
      "hash": "5beb4f9220",
      "file": "U10.L04/item.U10.L04.A1.a.why.5beb4f9220.mp3",
      "text": "الغذاء يصل من دم الأم عبر الحبل السري."
    },
    {
      "key": "item.U10.L04.A1.a.opt0",
      "hash": "5baa3256bc",
      "file": "U10.L04/item.U10.L04.A1.a.opt0.5baa3256bc.mp3",
      "text": "الجنين ليس في المعدة؛ الأم تهضم، ثم يصل الغذاء بالدم."
    },
    {
      "key": "item.U10.L04.A1.a.alt",
      "hash": "edb5f3a798",
      "file": "U10.L04/item.U10.L04.A1.a.alt.edb5f3a798.mp3",
      "text": "الرحم:"
    },
    {
      "key": "item.U10.L04.A1.a.alt.why",
      "hash": "0ec63b556a",
      "file": "U10.L04/item.U10.L04.A1.a.alt.why.0ec63b556a.mp3",
      "text": "ينمو فيه الجنين حتى يولد."
    },
    {
      "key": "item.U10.L04.A1.a.alt.opt1",
      "hash": "9514c357f2",
      "file": "U10.L04/item.U10.L04.A1.a.alt.opt1.9514c357f2.mp3",
      "text": "ليس من المعدة."
    },
    {
      "key": "item.U10.L04.A1.a.alt.opt2",
      "hash": "71ead09b5e",
      "file": "U10.L04/item.U10.L04.A1.a.alt.opt2.71ead09b5e.mp3",
      "text": "ليس عظماً."
    },
    {
      "key": "item.U10.L04.A1.a.alt.opt3",
      "hash": "9e2457ee1b",
      "file": "U10.L04/item.U10.L04.A1.a.alt.opt3.9e2457ee1b.mp3",
      "text": "ليس وعاء دموياً."
    },
    {
      "key": "item.U10.L04.A1.b",
      "hash": "68163ea281",
      "file": "U10.L04/item.U10.L04.A1.b.68163ea281.mp3",
      "text": "«يبدأ الإنسان خلية واحدة اجتمعت فيها خلية من الأم وخلية من الأب». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A1.b.alt",
      "hash": "b28c70caff",
      "file": "U10.L04/item.U10.L04.A1.b.alt.b28c70caff.mp3",
      "text": "«يولد الطفل عادة بعد نحو أربعين أسبوعاً في الرحم». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A1.c.m",
      "gender": "m",
      "hash": "65d613e0ab",
      "file": "U10.L04/item.U10.L04.A1.c.m.65d613e0ab.mp3",
      "text": "سألك أخوك الصغير: «من أين جاءت السرّة؟». أجبه بما تعلمت."
    },
    {
      "key": "item.U10.L04.A1.c.f",
      "gender": "f",
      "hash": "798a734dbc",
      "file": "U10.L04/item.U10.L04.A1.c.f.798a734dbc.mp3",
      "text": "سألكِ أخوكِ الصغير: «من أين جاءت السرّة؟». أجيبيه بما تعلمتِ."
    },
    {
      "key": "item.U10.L04.A2.a",
      "hash": "3f91f1439b",
      "file": "U10.L04/item.U10.L04.A2.a.3f91f1439b.mp3",
      "text": "في أي مرحلة يتوقف الطول عادة؟"
    },
    {
      "key": "item.U10.L04.A2.a.why",
      "hash": "9e55ba8770",
      "file": "U10.L04/item.U10.L04.A2.a.why.9e55ba8770.mp3",
      "text": "في الرشد، بعد نهاية البلوغ."
    },
    {
      "key": "item.U10.L04.A2.a.opt0",
      "hash": "0487fa1fe3",
      "file": "U10.L04/item.U10.L04.A2.a.opt0.0487fa1fe3.mp3",
      "text": "الرضيع يطول بسرعة."
    },
    {
      "key": "item.U10.L04.A2.a.opt1",
      "hash": "589a01ea23",
      "file": "U10.L04/item.U10.L04.A2.a.opt1.589a01ea23.mp3",
      "text": "الطفل يطول كل سنة."
    },
    {
      "key": "item.U10.L04.A2.a.opt3",
      "hash": "d22d1d49a0",
      "file": "U10.L04/item.U10.L04.A2.a.opt3.d22d1d49a0.mp3",
      "text": "في البلوغ طفرة طول."
    },
    {
      "key": "item.U10.L04.A2.a.alt",
      "hash": "6a84d199cc",
      "file": "U10.L04/item.U10.L04.A2.a.alt.6a84d199cc.mp3",
      "text": "آخر مراحل العمر:"
    },
    {
      "key": "item.U10.L04.A2.a.alt.why",
      "hash": "6a4e77ad73",
      "file": "U10.L04/item.U10.L04.A2.a.alt.why.6a4e77ad73.mp3",
      "text": "الشيخوخة."
    },
    {
      "key": "item.U10.L04.A2.a.alt.opt1",
      "hash": "4743d580d0",
      "file": "U10.L04/item.U10.L04.A2.a.alt.opt1.4743d580d0.mp3",
      "text": "الطفولة في أوله."
    },
    {
      "key": "item.U10.L04.A2.a.alt.opt2",
      "hash": "75d09b1cf8",
      "file": "U10.L04/item.U10.L04.A2.a.alt.opt2.75d09b1cf8.mp3",
      "text": "البلوغ في وسطه."
    },
    {
      "key": "item.U10.L04.A2.a.alt.opt3",
      "hash": "e3f2ecba88",
      "file": "U10.L04/item.U10.L04.A2.a.alt.opt3.e3f2ecba88.mp3",
      "text": "الرضاعة أوله."
    },
    {
      "key": "item.U10.L04.A2.b",
      "hash": "22b392db53",
      "file": "U10.L04/item.U10.L04.A2.b.22b392db53.mp3",
      "text": "«حدود مراحل العمر واحدة عند كل الناس بالضبط». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A2.b.alt",
      "hash": "2e630abc74",
      "file": "U10.L04/item.U10.L04.A2.b.alt.2e630abc74.mp3",
      "text": "«الطفولة مرحلة طول وتعلم كثير». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A2.c.m",
      "gender": "m",
      "hash": "1b85eb6155",
      "file": "U10.L04/item.U10.L04.A2.c.m.1b85eb6155.mp3",
      "text": "اختر مرحلتين من مراحل العمر، وقارن بينهما في الطول والحركة."
    },
    {
      "key": "item.U10.L04.A2.c.f",
      "gender": "f",
      "hash": "cea053be68",
      "file": "U10.L04/item.U10.L04.A2.c.f.cea053be68.mp3",
      "text": "اختاري مرحلتين من مراحل العمر، وقارني بينهما في الطول والحركة."
    },
    {
      "key": "item.U10.L04.A3.a",
      "hash": "cc4a9398d0",
      "file": "U10.L04/item.U10.L04.A3.a.cc4a9398d0.mp3",
      "text": "لماذا يقرّب بعض الكبار الكتاب أو يبعدونه ويلبسون نظارة القراءة؟"
    },
    {
      "key": "item.U10.L04.A3.a.why",
      "hash": "2ed6422d70",
      "file": "U10.L04/item.U10.L04.A3.a.why.2ed6422d70.mp3",
      "text": "مع العمر يصعب على العين التركيز على القريب."
    },
    {
      "key": "item.U10.L04.A3.a.opt0",
      "hash": "40914ed1da",
      "file": "U10.L04/item.U10.L04.A3.a.opt0.40914ed1da.mp3",
      "text": "الحجم ليس السبب."
    },
    {
      "key": "item.U10.L04.A3.a.opt1",
      "hash": "1f3a186dce",
      "file": "U10.L04/item.U10.L04.A3.a.opt1.1f3a186dce.mp3",
      "text": "كثير منهم يحبون القراءة."
    },
    {
      "key": "item.U10.L04.A3.a.opt2",
      "hash": "c6df729964",
      "file": "U10.L04/item.U10.L04.A3.a.opt2.c6df729964.mp3",
      "text": "الضوء الجيد يعين ولا يضر."
    },
    {
      "key": "item.U10.L04.A3.a.alt",
      "hash": "a79e6aa317",
      "file": "U10.L04/item.U10.L04.A3.a.alt.a79e6aa317.mp3",
      "text": "في الكبر قد يضعف سماع:"
    },
    {
      "key": "item.U10.L04.A3.a.alt.why",
      "hash": "dc93f7d89e",
      "file": "U10.L04/item.U10.L04.A3.a.alt.why.dc93f7d89e.mp3",
      "text": "الأصوات الحادة خاصة."
    },
    {
      "key": "item.U10.L04.A3.a.alt.opt1",
      "hash": "0b61e91b2b",
      "file": "U10.L04/item.U10.L04.A3.a.alt.opt1.0b61e91b2b.mp3",
      "text": "ليس فجأة ولا كلها."
    },
    {
      "key": "item.U10.L04.A3.a.alt.opt2",
      "hash": "115fe444d2",
      "file": "U10.L04/item.U10.L04.A3.a.alt.opt2.115fe444d2.mp3",
      "text": "الأصوات الحادة هي الأكثر."
    },
    {
      "key": "item.U10.L04.A3.a.alt.opt3",
      "hash": "22863bdf17",
      "file": "U10.L04/item.U10.L04.A3.a.alt.opt3.22863bdf17.mp3",
      "text": "ليس هذا تحديداً."
    },
    {
      "key": "item.U10.L04.A3.b",
      "hash": "486b373656",
      "file": "U10.L04/item.U10.L04.A3.b.486b373656.mp3",
      "text": "«الكبار لا يستفيدون من الرياضة». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A3.b.alt",
      "hash": "f9a7ae6be1",
      "file": "U10.L04/item.U10.L04.A3.b.alt.f9a7ae6be1.mp3",
      "text": "«ينقص طول الإنسان قليلاً في الكبر». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A3.c.m",
      "gender": "m",
      "hash": "dacd98b9d8",
      "file": "U10.L04/item.U10.L04.A3.c.m.dacd98b9d8.mp3",
      "text": "جدك يمشي ببطء، ولا يحمل الأغراض الثقيلة، ويلبس نظارة للقراءة. فسّر ذلك بثلاثة أجزاء من الجسم."
    },
    {
      "key": "item.U10.L04.A3.c.f",
      "gender": "f",
      "hash": "c29800ab50",
      "file": "U10.L04/item.U10.L04.A3.c.f.c29800ab50.mp3",
      "text": "جدكِ يمشي ببطء، ولا يحمل الأغراض الثقيلة، ويلبس نظارة للقراءة. فسّري ذلك بثلاثة أجزاء من الجسم."
    },
    {
      "key": "item.U10.L04.A4.a.m",
      "gender": "m",
      "hash": "248b982949",
      "file": "U10.L04/item.U10.L04.A4.a.m.248b982949.mp3",
      "text": "جارك الكبير لا يسمعك جيداً. ماذا تفعل؟"
    },
    {
      "key": "item.U10.L04.A4.a.f",
      "gender": "f",
      "hash": "a9acb95d9a",
      "file": "U10.L04/item.U10.L04.A4.a.f.a9acb95d9a.mp3",
      "text": "جاركِ الكبير لا يسمعكِ جيداً. ماذا تفعلين؟"
    },
    {
      "key": "item.U10.L04.A4.a.why",
      "hash": "84a8ee44de",
      "file": "U10.L04/item.U10.L04.A4.a.why.84a8ee44de.mp3",
      "text": "الوضوح والوجه المقابل يعينان من ضعف سمعه."
    },
    {
      "key": "item.U10.L04.A4.a.opt0",
      "hash": "a485bd2013",
      "file": "U10.L04/item.U10.L04.A4.a.opt0.a485bd2013.mp3",
      "text": "الكلام معه برّ."
    },
    {
      "key": "item.U10.L04.A4.a.opt3",
      "hash": "2870e62c0c",
      "file": "U10.L04/item.U10.L04.A4.a.opt3.2870e62c0c.mp3",
      "text": "لا نسخر."
    },
    {
      "key": "item.U10.L04.A4.a.alt",
      "hash": "85f3a1db2a",
      "file": "U10.L04/item.U10.L04.A4.a.alt.85f3a1db2a.mp3",
      "text": "من البر بالكبار:"
    },
    {
      "key": "item.U10.L04.A4.a.alt.why",
      "hash": "5cb591191b",
      "file": "U10.L04/item.U10.L04.A4.a.alt.why.5cb591191b.mp3",
      "text": "حمل الثقيل عنهم."
    },
    {
      "key": "item.U10.L04.A4.a.alt.opt2",
      "hash": "f39e68af2a",
      "file": "U10.L04/item.U10.L04.A4.a.alt.opt2.f39e68af2a.mp3",
      "text": "الحكم بالعمر يضر."
    },
    {
      "key": "item.U10.L04.A4.a.alt.opt3",
      "hash": "808e80046d",
      "file": "U10.L04/item.U10.L04.A4.a.alt.opt3.808e80046d.mp3",
      "text": "نزورهم ونكون معهم."
    },
    {
      "key": "item.U10.L04.A4.b",
      "hash": "fd6bbee0f2",
      "file": "U10.L04/item.U10.L04.A4.b.fd6bbee0f2.mp3",
      "text": "«الظن بأن الكبار ضعفاء أو عبء يضر بصحتهم». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A4.b.alt",
      "hash": "e7abd2c9bc",
      "file": "U10.L04/item.U10.L04.A4.b.alt.e7abd2c9bc.mp3",
      "text": "«كثير من الكبار يتعلمون أشياء جديدة». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A4.c.m",
      "gender": "m",
      "hash": "8ac0499a86",
      "file": "U10.L04/item.U10.L04.A4.c.m.8ac0499a86.mp3",
      "text": "خطّط لزيارة كبير تعرفه: ماذا تفعل معه؟ ولماذا ينفعه كل شيء؟"
    },
    {
      "key": "item.U10.L04.A4.c.f",
      "gender": "f",
      "hash": "ed81c90be0",
      "file": "U10.L04/item.U10.L04.A4.c.f.ed81c90be0.mp3",
      "text": "خطّطي لزيارة كبير تعرفه: ماذا تفعلين معه؟ ولماذا ينفعه كل شيء؟"
    },
    {
      "key": "item.U10.L04.A5.a",
      "hash": "137a519aca",
      "file": "U10.L04/item.U10.L04.A5.a.137a519aca.mp3",
      "text": "في تجربة دي كاسبر وفايفر، كيف «أجاب» المولود؟"
    },
    {
      "key": "item.U10.L04.A5.a.why",
      "hash": "4cc7cd944f",
      "file": "U10.L04/item.U10.L04.A5.a.why.4cc7cd944f.mp3",
      "text": "طريقة المص اختارت الصوت الذي يسمعه."
    },
    {
      "key": "item.U10.L04.A5.a.opt0",
      "hash": "0e2b902e55",
      "file": "U10.L04/item.U10.L04.A5.a.opt0.0e2b902e55.mp3",
      "text": "المولود لا يتكلم."
    },
    {
      "key": "item.U10.L04.A5.a.opt1",
      "hash": "bda56f7a32",
      "file": "U10.L04/item.U10.L04.A5.a.opt1.bda56f7a32.mp3",
      "text": "لا يشير."
    },
    {
      "key": "item.U10.L04.A5.a.opt3",
      "hash": "c83bdd615a",
      "file": "U10.L04/item.U10.L04.A5.a.opt3.c83bdd615a.mp3",
      "text": "لا يكتب."
    },
    {
      "key": "item.U10.L04.A5.a.alt",
      "hash": "5a7deff32e",
      "file": "U10.L04/item.U10.L04.A5.a.alt.5a7deff32e.mp3",
      "text": "الحبل السري متصل في الرحم بعضو اسمه:"
    },
    {
      "key": "item.U10.L04.A5.a.alt.why",
      "hash": "2e4d884749",
      "file": "U10.L04/item.U10.L04.A5.a.alt.why.2e4d884749.mp3",
      "text": "المشيمة."
    },
    {
      "key": "item.U10.L04.A5.a.alt.opt1",
      "hash": "95d4698cd7",
      "file": "U10.L04/item.U10.L04.A5.a.alt.opt1.95d4698cd7.mp3",
      "text": "ليس المعدة."
    },
    {
      "key": "item.U10.L04.A5.a.alt.opt2",
      "hash": "21fedc929c",
      "file": "U10.L04/item.U10.L04.A5.a.alt.opt2.21fedc929c.mp3",
      "text": "ليس الكلية."
    },
    {
      "key": "item.U10.L04.A5.a.alt.opt3",
      "hash": "23f9f079bb",
      "file": "U10.L04/item.U10.L04.A5.a.alt.opt3.23f9f079bb.mp3",
      "text": "ليس الرئة."
    },
    {
      "key": "item.U10.L04.A5.b",
      "hash": "d26b04dcc9",
      "file": "U10.L04/item.U10.L04.A5.b.d26b04dcc9.mp3",
      "text": "«المولود لا يعرف صوت أمه حين يولد». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A5.b.alt",
      "hash": "b3e1276498",
      "file": "U10.L04/item.U10.L04.A5.b.alt.b3e1276498.mp3",
      "text": "«المولود في التجربة كان حديث الولادة، فتعلّمُه صوت أمه كان على الأرجح قبل الولادة». صح أم خطأ؟ ولماذا؟"
    },
    {
      "key": "item.U10.L04.A5.c",
      "hash": "ff1cb05ed8",
      "file": "U10.L04/item.U10.L04.A5.c.ff1cb05ed8.mp3",
      "text": "لماذا استعمل الباحثون صوت امرأة أخرى في التجربة، لا صوت الأم وحده؟"
    },
    {
      "key": "item.U10.L04.D1",
      "hash": "5f4079dbb1",
      "file": "U10.L04/item.U10.L04.D1.5f4079dbb1.mp3",
      "text": "ينمو الجنين في:"
    },
    {
      "key": "item.U10.L04.D2",
      "hash": "a222d7108a",
      "file": "U10.L04/item.U10.L04.D2.a222d7108a.mp3",
      "text": "المرحلة بعد الطفولة:"
    },
    {
      "key": "item.U10.L04.D2.why",
      "hash": "b9fb8398db",
      "file": "U10.L04/item.U10.L04.D2.why.b9fb8398db.mp3",
      "text": "البلوغ."
    },
    {
      "key": "item.U10.L04.D2.opt1",
      "hash": "fc96ae5764",
      "file": "U10.L04/item.U10.L04.D2.opt1.fc96ae5764.mp3",
      "text": "قبلها."
    },
    {
      "key": "item.U10.L04.D2.opt2",
      "hash": "23c50fcb17",
      "file": "U10.L04/item.U10.L04.D2.opt2.23c50fcb17.mp3",
      "text": "آخر العمر."
    },
    {
      "key": "item.U10.L04.D3",
      "hash": "8cda785892",
      "file": "U10.L04/item.U10.L04.D3.8cda785892.mp3",
      "text": "يبطئ ضعف العظم في الكبر:"
    },
    {
      "key": "item.U10.L04.D3.why",
      "hash": "bc87106e26",
      "file": "U10.L04/item.U10.L04.D3.why.bc87106e26.mp3",
      "text": "الحركة."
    },
    {
      "key": "item.U10.L04.D3.opt1",
      "hash": "57bc7fd6d7",
      "file": "U10.L04/item.U10.L04.D3.opt1.57bc7fd6d7.mp3",
      "text": "يضعفه."
    },
    {
      "key": "item.U10.L04.D3.opt2",
      "hash": "8990c11af9",
      "file": "U10.L04/item.U10.L04.D3.opt2.8990c11af9.mp3",
      "text": "لا يعين."
    },
    {
      "key": "item.U10.L04.D4",
      "hash": "4448feb0cf",
      "file": "U10.L04/item.U10.L04.D4.4448feb0cf.mp3",
      "text": "نكلم من ضعف سمعه:"
    },
    {
      "key": "item.U10.L04.D4.why",
      "hash": "656d8a01cc",
      "file": "U10.L04/item.U10.L04.D4.why.656d8a01cc.mp3",
      "text": "بوضوح ووجهنا إليه."
    },
    {
      "key": "item.U10.L04.D4.opt1",
      "hash": "21088acbfe",
      "file": "U10.L04/item.U10.L04.D4.opt1.21088acbfe.mp3",
      "text": "لا."
    },
    {
      "key": "item.U10.L04.D4.opt2",
      "hash": "3781cb4e24",
      "file": "U10.L04/item.U10.L04.D4.opt2.3781cb4e24.mp3",
      "text": "يحتاج أن يرى وجهنا."
    },
    {
      "key": "item.U10.L04.D5",
      "hash": "6e76958151",
      "file": "U10.L04/item.U10.L04.D5.6e76958151.mp3",
      "text": "المولود في التجربة اختار:"
    },
    {
      "key": "item.U10.L04.D5.why",
      "hash": "e2a4669463",
      "file": "U10.L04/item.U10.L04.D5.why.e2a4669463.mp3",
      "text": "صوت أمه."
    },
    {
      "key": "item.U10.L04.D5.opt1",
      "hash": "cd60df30c1",
      "file": "U10.L04/item.U10.L04.D5.opt1.cd60df30c1.mp3",
      "text": "اختار صوت أمه أكثر."
    },
    {
      "key": "item.U10.L04.T1.m",
      "gender": "m",
      "hash": "db683304d7",
      "file": "U10.L04/item.U10.L04.T1.m.db683304d7.mp3",
      "text": "جدتك ستسكن معكم. صمّم غرفتها لتناسب ما يتغير في الكبر: الضوء، والممرات، وأماكن الأشياء."
    },
    {
      "key": "item.U10.L04.T1.f",
      "gender": "f",
      "hash": "320fff299a",
      "file": "U10.L04/item.U10.L04.T1.f.320fff299a.mp3",
      "text": "جدتكِ ستسكن معكم. صمّمي غرفتها لتناسب ما يتغير في الكبر: الضوء، والممرات، وأماكن الأشياء."
    },
    {
      "key": "item.U10.L04.T2.m",
      "gender": "m",
      "hash": "e861d11cc3",
      "file": "U10.L04/item.U10.L04.T2.m.e861d11cc3.mp3",
      "text": "ستولد لكم أخت قريباً. اكتب لها رسالة تصف فيها كيف كانت تنمو قبل أن تولد."
    },
    {
      "key": "item.U10.L04.T2.f",
      "gender": "f",
      "hash": "f99cfe4146",
      "file": "U10.L04/item.U10.L04.T2.f.f99cfe4146.mp3",
      "text": "ستولد لكم أخت قريباً. اكتبي لها رسالة تصفين فيها كيف كانت تنمو قبل أن تولد."
    },
    {
      "key": "notebook.m",
      "gender": "m",
      "hash": "e24783b0ec",
      "file": "U10.L04/notebook.m.e24783b0ec.mp3",
      "text": "ارسم شريط العمر: خلية، جنين في الرحم مع الحبل السري، مولود، طفل، بالغ، راشد، كبير في السن. المستوى ب: ارسم المشيمة واكتب تجربة اللهاية."
    },
    {
      "key": "notebook.f",
      "gender": "f",
      "hash": "81df905332",
      "file": "U10.L04/notebook.f.81df905332.mp3",
      "text": "ارسمي شريط العمر: خلية، جنين في الرحم مع الحبل السري، مولود، طفل، بالغ، راشد، كبير في السن. المستوى ب: ارسمي المشيمة واكتبي تجربة اللهاية."
    },
    {
      "key": "how_we_know",
      "hash": "f813e08e1b",
      "file": "U10.L04/how_we_know.f813e08e1b.mp3",
      "text": "كيف عرف العلماء أن المولود يعرف صوت أمه؟ المولود لا يتكلم، لكنه يمص. في تجربة دي كاسبر وفايفر (1980) أعطوا المولود لهاية: إذا مصها بطريقة سمع صوت أمه تقرأ، وإذا مصها بطريقة أخرى سمع صوت امرأة أخرى. فتعلم الأطفال الطريقة التي تُسمعهم صوت الأم، واختاروه أكثر. ولأنهم كانوا حديثي الولادة، رأى الباحثون أنهم تعلموا صوتها وهم في الرحم."
    },
    {
      "key": "how_we_know.limit",
      "hash": "45f3abddf3",
      "file": "U10.L04/how_we_know.limit.45f3abddf3.mp3",
      "text": "لماذا قال الباحثون إن الأطفال تعلموا الصوت قبل الولادة، لا بعدها؟"
    },
    {
      "key": "organ_letter.m",
      "gender": "m",
      "hash": "7ab4c41f80",
      "file": "U10.L04/organ_letter.m.7ab4c41f80.mp3",
      "text": "مرحباً، نحن عظامك. حين كنت جنيناً في الرحم كنا طرية، ثم قسونا وطلنا معك، وما زلنا نطول. وبعد سنين طويلة، حين تكبر، سنفقد شيئاً من قوتنا، كما حدث لعظام جدك وجدتك. لكن لنا سرّاً: كلما تحركت وأكلت طعاماً متوازناً الآن، صرنا أقوى، وبقينا أقوى في الكبر. فإذا رأيت كبيراً يمشي ببطء، امش معه، واحمل عنه الثقيل؛ فعظامه تشكرك، ونحن أيضاً."
    },
    {
      "key": "organ_letter.f",
      "gender": "f",
      "hash": "247036391e",
      "file": "U10.L04/organ_letter.f.247036391e.mp3",
      "text": "مرحباً، نحن عظامكِ. حين كنتِ جنيناً في الرحم كنا طرية، ثم قسونا وطلنا معكِ، وما زلنا نطول. وبعد سنين طويلة، حين تكبرين، سنفقد شيئاً من قوتنا، كما حدث لعظام جدكِ وجدتكِ. لكن لنا سرّاً: كلما تحركتِ وأكلتِ طعاماً متوازناً الآن، صرنا أقوى، وبقينا أقوى في الكبر. فإذا رأيتِ كبيراً يمشي ببطء، امشي معه، واحملي عنه الثقيل؛ فعظامه تشكركِ، ونحن أيضاً."
    },
    {
      "key": "history.1.who",
      "hash": "4b3462199b",
      "file": "U10.L04/history.1.who.4b3462199b.mp3",
      "text": "أنتوني دي كاسبر وويليام فايفر"
    },
    {
      "key": "history.1.did",
      "hash": "4786aca445",
      "file": "U10.L04/history.1.did.4786aca445.mp3",
      "text": "صمما تجربة يختار فيها المولود الصوت الذي يسمعه بطريقة مصه اللهاية، فاختار المواليد صوت أمهاتهم أكثر من صوت امرأة أخرى."
    },
    {
      "key": "history.1.method",
      "hash": "70d2425578",
      "file": "U10.L04/history.1.method.70d2425578.mp3",
      "text": "إذا لم يستطع من ندرسه أن يتكلم، نبحث عن سلوك يستطيعه ونجعله «جواباً»."
    },
    {
      "key": "life.1.situation",
      "hash": "5f2d6c0390",
      "file": "U10.L04/life.1.situation.5f2d6c0390.mp3",
      "text": "أبي وأمي يكبران، وأحياناً يطلبان مني شيئاً مرة بعد مرة، فأضجر."
    },
    {
      "key": "life.1.action",
      "hash": "b17360a8f9",
      "file": "U10.L04/life.1.action.b17360a8f9.mp3",
      "text": "أجيب بلطف ولو تكرر الطلب، ولا أرفع صوتي، وأحمل عنهما ما يثقل."
    },
    {
      "key": "life.1.why",
      "hash": "bdebc404e8",
      "file": "U10.L04/life.1.why.bdebc404e8.mp3",
      "text": "لماذا لا أقول ولو كلمة ضجر صغيرة؟ لأن الله أمر بالإحسان إلى الوالدين، وخاصة حين يكبران، وأن نكلمهما بأحسن الكلام وندعو لهما، كما في الآيتين في البطاقة."
    },
    {
      "key": "life.2.situation",
      "hash": "3b570caa52",
      "file": "U10.L04/life.2.situation.3b570caa52.mp3",
      "text": "في الحافلة صعد رجل كبير يمشي ببطء، وكل المقاعد مشغولة."
    },
    {
      "key": "life.2.action",
      "hash": "a34ccd8063",
      "file": "U10.L04/life.2.action.a34ccd8063.mp3",
      "text": "أقوم له عن مقعدي، وأبتسم، وأساعده إن احتاج."
    },
    {
      "key": "life.2.why",
      "hash": "d36e767f4c",
      "file": "U10.L04/life.2.why.d36e767f4c.mp3",
      "text": "لماذا أقوم وأنا تعبت أيضاً؟ لأني أقوى منه الآن، وتوقير الكبير من أخلاقنا، كما في الحديث في البطاقة."
    },
    {
      "key": "hadith.tirmidhi:1919",
      "hash": "108d96ddf2",
      "file": "U10.L04/hadith.tirmidhi:1919.108d96ddf2.mp3",
      "text": "عن أنس بن مالك رضي الله عنه قال: قال رسول الله ﷺ: ليس منا من لم يرحم صغيرنا، ويوقر كبيرنا."
    },
    {
      "key": "open.1.q",
      "hash": "eee4b3fe26",
      "file": "U10.L04/open.1.q.eee4b3fe26.mp3",
      "text": "لماذا يشيخ بعض الناس أبطأ من غيرهم؟"
    },
    {
      "key": "open.1.why",
      "hash": "7ca4444803",
      "file": "U10.L04/open.1.why.7ca4444803.mp3",
      "text": "للوراثة والعادات والبيئة أثر، والعلماء ما زالوا يدرسون كيف يجتمع ذلك في الخلايا."
    },
    {
      "key": "faith.opening.reflection.m",
      "gender": "m",
      "hash": "b7fe7a323c",
      "file": "U10.L04/faith.opening.reflection.m.b7fe7a323c.mp3",
      "text": "في الآية التي أمامك تذكير بالبداية: أن الله أخرجنا من بطون أمهاتنا. واليوم نتعلم كيف نما كل واحد منا قبل أن يولد، وكيف يتغير الجسم حتى الكبر. والآية لا تشرح الخلايا ولا الحبل السري، والعلم لا يشرح الآية؛ لكن من عرف رحلته من خلية واحدة إلى ما هو عليه عرف قدر النعمة، وقدر أمه التي حملته. ماذا تقول لأمك اليوم؟"
    },
    {
      "key": "faith.opening.reflection.f",
      "gender": "f",
      "hash": "3630cba7a1",
      "file": "U10.L04/faith.opening.reflection.f.3630cba7a1.mp3",
      "text": "في الآية التي أمامكِ تذكير بالبداية: أن الله أخرجنا من بطون أمهاتنا. واليوم نتعلم كيف نما كل واحد منا قبل أن يولد، وكيف يتغير الجسم حتى الكبر. والآية لا تشرح الخلايا ولا الحبل السري، والعلم لا يشرح الآية؛ لكن من عرف رحلته من خلية واحدة إلى ما هو عليه عرف قدر النعمة، وقدر أمه التي حملته. ماذا تقولين لأمكِ اليوم؟"
    },
    {
      "key": "faith.closing.lead",
      "hash": "8d51decb04",
      "file": "U10.L04/faith.closing.lead.8d51decb04.mp3",
      "text": "عن أنس بن مالك رضي الله عنه قال: قال رسول الله ﷺ:"
    },
    {
      "key": "faith.closing.text",
      "hash": "9bb375398e",
      "file": "U10.L04/faith.closing.text.9bb375398e.mp3",
      "text": "ليس منا من لم يرحم صغيرنا، ويوقر كبيرنا."
    },
    {
      "key": "faith.closing.reflection.m",
      "gender": "m",
      "hash": "3c7f85d1f1",
      "file": "U10.L04/faith.closing.reflection.m.3c7f85d1f1.mp3",
      "text": "عرفنا اليوم أن الجسم يتغير في الكبر، فيضعف العظم والعضلة والسمع والبصر. والحديث في البطاقة يجمع الصغير والكبير: نرحم الصغير ونوقّر الكبير. والحديث لا يشرح الشيخوخة، والعلم لا يشرحه؛ لكنه يعلّمنا أن نعين الكبار ونحترمهم. كيف توقّر كبيراً تعرفه هذا الأسبوع؟"
    },
    {
      "key": "faith.closing.reflection.f",
      "gender": "f",
      "hash": "2f3a20c6c4",
      "file": "U10.L04/faith.closing.reflection.f.2f3a20c6c4.mp3",
      "text": "عرفنا اليوم أن الجسم يتغير في الكبر، فيضعف العظم والعضلة والسمع والبصر. والحديث في البطاقة يجمع الصغير والكبير: نرحم الصغير ونوقّر الكبير. والحديث لا يشرح الشيخوخة، والعلم لا يشرحه؛ لكنه يعلّمنا أن نعين الكبار ونحترمهم. كيف توقّرين كبيراً تعرفه هذا الأسبوع؟"
    },
    {
      "key": "number.bee31ada75",
      "hash": "bee31ada75",
      "file": "U10.L04/number.bee31ada75.bee31ada75.mp3",
      "text": "نحو أربعين أسبوعاً في الرحم، أي نحو تسعة أشهر."
    },
    {
      "key": "number.ba75f46a5a",
      "hash": "ba75f46a5a",
      "file": "U10.L04/number.ba75f46a5a.ba75f46a5a.mp3",
      "text": "واحد من كل ستة أشخاص في العالم في الستين أو أكثر بحلول 2030."
    },
    {
      "key": "size.bf37f728d7.m",
      "gender": "m",
      "hash": "f39db6ac92",
      "file": "U10.L04/size.bf37f728d7.m.f39db6ac92.mp3",
      "text": "بدأت خلية واحدة لا تُرى بالعين، وصار جسمك اليوم من عدد هائل من الخلايا."
    },
    {
      "key": "size.bf37f728d7.f",
      "gender": "f",
      "hash": "21b50a4ecb",
      "file": "U10.L04/size.bf37f728d7.f.21b50a4ecb.mp3",
      "text": "بدأتِ خلية واحدة لا تُرى بالعين، وصار جسمكِ اليوم من عدد هائل من الخلايا."
    },
    {
      "key": "central_fact",
      "hash": "e9a5429e6b",
      "file": "U10.L04/central_fact.e9a5429e6b.mp3",
      "text": "يبدأ الإنسان خلية واحدة اجتمعت فيها خلية من الأم وخلية من الأب، ثم ينمو جنيناً في الرحم نحو أربعين أسبوعاً، ثم يمر بمراحل العمر حتى الشيخوخة، فيتغير العظم والعضلة والعين والأذن؛ والحركة تبطئ ذلك، والبر يعين الكبار."
    },
    {
      "key": "scene.09af686d09",
      "hash": "09af686d09",
      "file": "U10.L04/scene.09af686d09.09af686d09.mp3",
      "text": "صحيح. والتالي؟"
    },
    {
      "key": "scene.a1a34e0404.m",
      "gender": "m",
      "hash": "b2c7295645",
      "file": "U10.L04/scene.a1a34e0404.m.b2c7295645.mp3",
      "text": "ليس هذا. فكّر مرة أخرى."
    },
    {
      "key": "scene.a1a34e0404.f",
      "gender": "f",
      "hash": "d7ff5f90bb",
      "file": "U10.L04/scene.a1a34e0404.f.d7ff5f90bb.mp3",
      "text": "ليس هذا. فكّري مرة أخرى."
    },
    {
      "key": "scene.349ac8317e",
      "hash": "349ac8317e",
      "file": "U10.L04/scene.349ac8317e.349ac8317e.mp3",
      "text": "من خلية واحدة لا تُرى، إلى مولود بعد نحو أربعين أسبوعاً. هكذا بدأ كل واحد منا."
    },
    {
      "key": "scene.8640f1e318.m",
      "gender": "m",
      "hash": "723f4b5495",
      "file": "U10.L04/scene.8640f1e318.m.723f4b5495.mp3",
      "text": "اضغط للمرحلة التالية."
    },
    {
      "key": "scene.8640f1e318.f",
      "gender": "f",
      "hash": "72c3f5e39c",
      "file": "U10.L04/scene.8640f1e318.f.72c3f5e39c.mp3",
      "text": "اضغطي للمرحلة التالية."
    }
  ]
}